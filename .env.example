# Copy this file to .env.local and fill in the values.

# Neon (console.neon.tech -> Connect -> pooled connection string)
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Clerk (dashboard.clerk.com -> API Keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Firecrawl (firecrawl.dev -> dashboard)
FIRECRAWL_API_KEY=

# OpenRouter (openrouter.ai -> Keys). Used for the Jev decision model (bad-price guard).
# Optional: without it the guard fails open and prices update as before.
OPENROUTER_API_KEY=

# Email: Brevo is tried first, Resend is the fallback. Configure one or both.
# Brevo (brevo.com -> SMTP & API -> API Keys; SENDER_EMAIL must be a verified sender)
BREVO_API_KEY=
SENDER_EMAIL=

# Resend (resend.com -> API Keys)
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# Cron security: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=

NEXT_PUBLIC_APP_URL=http://localhost:3000
